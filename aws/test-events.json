{
  "prediction_screener": {
    "scheduled": {
      "run_type": "scheduled",
      "limit": 200,
      "return_days": 5,
      "lookback": 180
    },
    "adhoc_quick": {
      "run_type": "adhoc",
      "limit": 50,
      "return_days": 5,
      "lookback": 90
    },
    "adhoc_custom": {
      "run_type": "adhoc",
      "limit": 100,
      "return_days": 10,
      "lookback": 180
    }
  },
  "equity_screener": {
    "scheduled": {
      "run_type": "scheduled"
    },
    "adhoc": {
      "run_type": "adhoc",
      "config_path": "configs/equity_screener.json"
    }
  },
  "optimize_and_buy": {
